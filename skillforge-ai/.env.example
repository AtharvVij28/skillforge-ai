# Environment variables (template)

# Copy to .env and fill values. Never commit real secrets.

# Application
APP_NAME=SkillForge AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (replace YOUR_POSTGRES_PASSWORD locally — never commit a real password)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/skillforge_db

# Optional: dedicated URL for integration tests (defaults to DATABASE_URL when unset)
# TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/skillforge_db_test

# Auth / security (use a long random value locally — never commit real secrets)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development-only admin bootstrap (never used by public registration)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-dev-only

# File uploads
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt

# AI providers (mock | openai | other)
AI_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=mock
VECTOR_STORE=memory
AI_CHUNK_SIZE=800
AI_CHUNK_OVERLAP=100
AI_MIN_EVIDENCE_CHARS=80

# External course providers (mock credentials placeholders)
IGOT_API_BASE_URL=
IGOT_API_KEY=
NSSTA_API_BASE_URL=
NSSTA_API_KEY=
COURSE_PROVIDER_MODE=mock
